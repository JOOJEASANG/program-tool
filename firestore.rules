rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn(){ return request.auth != null; }
    function hasAdminClaim(){ return signedIn() && request.auth.token.admin == true; }
    function adminDoc(){ return get(/databases/$(database)/documents/settings/admin); }
    // Temporary migration fallback. Remove after every administrator has admin=true.
    function legacyAdmin(){ return signedIn() && exists(/databases/$(database)/documents/settings/admin) && request.auth.token.email != null && adminDoc().data.emails.hasAny([request.auth.token.email, request.auth.token.email.lower()]); }
    function isAdmin(){ return hasAdminClaim() || legacyAdmin(); }
    function permission(uid){ return get(/databases/$(database)/documents/user_permissions/$(uid)); }
    function approved(uid){ return isAdmin() || (exists(/databases/$(database)/documents/user_permissions/$(uid)) && permission(uid).data.status == 'approved'); }

    match /settings/admin {
      allow read: if isAdmin();
      allow create: if false;
      allow update, delete: if isAdmin();
    }

    match /settings/programs { allow read: if signedIn(); allow write: if isAdmin(); }
    match /settings/config { allow read, write: if isAdmin(); }
    match /settings/business { allow read: if true; allow write: if isAdmin(); }
    // Public home navigation/card catalog. Anyone may read the published catalog,
    // while only an administrator may create or change it.
    match /settings/public_program_catalog { allow read: if true; allow write: if isAdmin(); }

    match /user_permissions/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid','email','displayName','status','plan','programs','createdAt'])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email.lower()
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 100
        && request.resource.data.status == 'pending'
        && request.resource.data.plan == 'free'
        && request.resource.data.programs is map
        && request.resource.data.programs.keys().hasOnly(['pdf-editor','preflight','design-studio'])
        && request.resource.data.programs['pdf-editor'] == false
        && request.resource.data.programs.preflight == false
        && request.resource.data.programs['design-studio'] == false
        && request.resource.data.createdAt is timestamp;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /cover_templates/{templateId} {
      allow read: if signedIn() && (isAdmin() || (approved(request.auth.uid) && resource.data.isPublic == true));
      allow create: if isAdmin()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.isPublic is bool
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    match /users/{uid}/pdf_sessions/{docId} { allow read, write: if signedIn() && request.auth.uid == uid && approved(uid); }

    match /{document=**} { allow read, write: if false; }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn(){ return request.auth != null; }
    function hasAdminClaim(){ return signedIn() && request.auth.token.keys().hasAll(['admin']) && request.auth.token.admin == true; }
    function adminDoc(){ return get(/databases/$(database)/documents/settings/admin); }
    // Temporary migration fallback. Remove after every administrator has admin=true.
    function legacyAdmin(){ return signedIn() && request.auth.token.keys().hasAll(['email']) && exists(/databases/$(database)/documents/settings/admin) && request.auth.token.email != null && adminDoc().data.emails.hasAny([request.auth.token.email, request.auth.token.email.lower()]); }
    function isAdmin(){ return hasAdminClaim() || legacyAdmin(); }
    function permission(uid){ return get(/databases/$(database)/documents/user_permissions/$(uid)); }
    function approved(uid){ return isAdmin() || (exists(/databases/$(database)/documents/user_permissions/$(uid)) && permission(uid).data.status == 'approved'); }
    function programApproved(uid, programId){
      let data = permission(uid).data;
      return isAdmin() || (
        exists(/databases/$(database)/documents/user_permissions/$(uid))
        && data.status == 'approved'
        && (
          !data.keys().hasAny(['programsAll'])
          || data.programsAll == true
          || (
            data.programs is map
            && data.programs.keys().hasAny([programId])
            && data.programs[programId] == true
          )
        )
      );
    }
    function isOwner(uid){ return signedIn() && request.auth.uid == uid; }
    function validDesignProjectMetadata(uid, projectId){
      return request.resource.data.keys().hasOnly(['id','name','presetId','width','height','storagePath','size','updatedAt','createdAt'])
        && request.resource.data.id == projectId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.presetId is string
        && request.resource.data.presetId.size() > 0
        && request.resource.data.presetId.size() <= 80
        && request.resource.data.width is number
        && request.resource.data.width >= 20
        && request.resource.data.width <= 2000
        && request.resource.data.height is number
        && request.resource.data.height >= 20
        && request.resource.data.height <= 2000
        && request.resource.data.storagePath is string
        && request.resource.data.storagePath.matches('^design_projects/' + uid + '/' + projectId + '/[A-Za-z0-9_-]{1,80}[.]design[.]json$')
        && request.resource.data.size is int
        && request.resource.data.size > 0
        && request.resource.data.size <= 31457280
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.createdAt is timestamp;
    }
    function validPdfSessionMetadata(){
      return request.resource.data.keys().hasOnly(['name','sessionId','storagePaths','fileCount','pageCount','totalBytes','state','createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.sessionId is string
        && request.resource.data.sessionId.matches('^[A-Za-z0-9_-]{8,40}$')
        && request.resource.data.storagePaths is list
        && request.resource.data.fileCount is int
        && request.resource.data.fileCount > 0
        && request.resource.data.fileCount <= 50
        && request.resource.data.storagePaths.size() == request.resource.data.fileCount
        && request.resource.data.pageCount is int
        && request.resource.data.pageCount > 0
        && request.resource.data.pageCount <= 5000
        && request.resource.data.totalBytes is int
        && request.resource.data.totalBytes > 0
        && request.resource.data.totalBytes <= 314572800
        && request.resource.data.state is string
        && request.resource.data.state.size() > 0
        && request.resource.data.state.size() <= 900000
        && request.resource.data.createdAt is timestamp;
    }
    function validPdfDailyLimits(){
      return request.resource.data.keys().hasOnly(['guestLimit','memberLimit','updatedAt'])
        && request.resource.data.guestLimit is int
        && request.resource.data.guestLimit >= 1
        && request.resource.data.guestLimit <= 1000
        && request.resource.data.memberLimit is int
        && request.resource.data.memberLimit >= 1
        && request.resource.data.memberLimit <= 1000
        && request.resource.data.updatedAt is timestamp;
    }
    function validProgramUsageLimit(programId){
      return request.resource.data.keys().hasOnly(['programId','label','enabled','period','guestLimit','memberLimit','updatedAt'])
        && programId.matches('^[a-z0-9][a-z0-9-]{1,63}$')
        && request.resource.data.programId == programId
        && request.resource.data.label is string
        && request.resource.data.label.size() > 0
        && request.resource.data.label.size() <= 80
        && request.resource.data.enabled is bool
        && request.resource.data.period in ['daily','monthly']
        && request.resource.data.guestLimit is int
        && request.resource.data.guestLimit >= -1
        && request.resource.data.guestLimit <= 1000
        && request.resource.data.memberLimit is int
        && request.resource.data.memberLimit >= -1
        && request.resource.data.memberLimit <= 1000
        && request.resource.data.updatedAt is timestamp;
    }

    match /settings/admin {
      allow read: if isAdmin();
      allow create: if false;
      allow update, delete: if isAdmin();
    }

    match /settings/programs { allow read: if signedIn(); allow write: if isAdmin(); }
    match /settings/config { allow read, write: if isAdmin(); }
    match /settings/business { allow read: if true; allow write: if isAdmin(); }
    // Legacy usage-limit documents remain readable for rollback compatibility only.
    match /settings/pdf_daily_limits {
      allow read: if true;
      allow create, update: if isAdmin() && validPdfDailyLimits();
      allow delete: if isAdmin();
    }
    match /program_usage_limits/{programId} {
      allow read: if true;
      allow create, update: if isAdmin() && validProgramUsageLimit(programId);
      allow delete: if isAdmin();
    }
    match /settings/public_program_catalog { allow read: if true; allow write: if isAdmin(); }
    match /settings/professional_program_suite { allow read: if true; allow write: if isAdmin(); }

    match /user_permissions/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
        && request.auth.token.keys().hasAll(['email'])
        && request.resource.data.keys().hasOnly(['uid','email','displayName','status','plan','programsAll','programs','createdAt'])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email.lower()
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 100
        && request.resource.data.status == 'pending'
        && request.resource.data.plan == 'free'
        && request.resource.data.programsAll == false
        && request.resource.data.programs is map
        && request.resource.data.programs.keys().hasOnly(['print-checker','smart-print-layout','pdf-editor','pdf-editor-advanced','pdf-preflight'])
        && request.resource.data.programs['print-checker'] == false
        && request.resource.data.programs['smart-print-layout'] == false
        && request.resource.data.programs['pdf-editor'] == false
        && request.resource.data.programs['pdf-editor-advanced'] == false
        && request.resource.data.programs['pdf-preflight'] == false
        && request.resource.data.createdAt is timestamp;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Historical usage counters are read-only. The product now uses approval-based access,
    // so normal operation no longer spends Firestore writes on per-action counters.
    match /users/{uid}/daily_pdf_usage/{dateKey} {
      allow read: if isOwner(uid);
      allow create, update, delete: if false;
    }
    match /users/{uid}/program_usage/{usageKey} {
      allow read: if isOwner(uid);
      allow create, update, delete: if false;
    }

    match /users/{uid}/design_projects/{projectId} {
      allow read: if isOwner(uid) && approved(uid);
      allow create: if isOwner(uid) && approved(uid) && validDesignProjectMetadata(uid, projectId);
      allow update: if isOwner(uid)
        && approved(uid)
        && validDesignProjectMetadata(uid, projectId)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isOwner(uid);
    }

    match /cover_templates/{templateId} {
      allow read, delete: if isAdmin();
      allow create, update: if false;
    }

    match /users/{uid}/pdf_sessions/{docId} {
      allow read: if isOwner(uid) && programApproved(uid, 'pdf-editor');
      allow create: if isOwner(uid) && programApproved(uid, 'pdf-editor') && validPdfSessionMetadata();
      allow update: if false;
      allow delete: if isOwner(uid);
    }

    match /users/{uid}/pdf_advanced_sessions/{docId} {
      allow read: if isOwner(uid) && programApproved(uid, 'pdf-editor-advanced');
      allow create: if isOwner(uid) && programApproved(uid, 'pdf-editor-advanced') && validPdfSessionMetadata();
      allow update: if false;
      allow delete: if isOwner(uid);
    }

    match /users/{uid}/pdf_smart_layout_sessions/{docId} {
      allow read: if isOwner(uid) && programApproved(uid, 'smart-print-layout');
      allow create: if isOwner(uid) && programApproved(uid, 'smart-print-layout') && validPdfSessionMetadata();
      allow update: if false;
      allow delete: if isOwner(uid);
    }

    match /{document=**} { allow read, write: if false; }
  }
}

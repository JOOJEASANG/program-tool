rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn(){ return request.auth != null; }
    function hasAdminClaim(){ return signedIn() && request.auth.token.keys().hasAll(['admin']) && request.auth.token.admin == true; }
    function isAdmin(){ return hasAdminClaim(); }
    function permission(uid){ return get(/databases/$(database)/documents/user_permissions/$(uid)); }
    function approved(uid){ return isAdmin() || (exists(/databases/$(database)/documents/user_permissions/$(uid)) && permission(uid).data.status == 'approved'); }
    function isOwner(uid){ return signedIn() && request.auth.uid == uid; }
    function validBusinessPrivate(){
      // 700k permits one-time migration of legacy <=500KB images after base64 expansion.
      // The current admin UI still caps all new stamp uploads at 300KB raw.
      return request.resource.data.keys().hasOnly(['stampData','updatedAt'])
        && (!request.resource.data.keys().hasAny(['stampData'])
          || (request.resource.data.stampData is string && request.resource.data.stampData.size() <= 700000))
        && (!request.resource.data.keys().hasAny(['updatedAt']) || request.resource.data.updatedAt is timestamp);
    }
    function validDesignProjectMetadata(uid, projectId){
      return request.resource.data.keys().hasOnly(['id','name','presetId','width','height','storagePath','size','updatedAt','createdAt'])
        && request.resource.data.id == projectId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.presetId is string
        && request.resource.data.presetId.size() > 0
        && request.resource.data.presetId.size() <= 80
        && request.resource.data.width is number
        && request.resource.data.width >= 20
        && request.resource.data.width <= 2000
        && request.resource.data.height is number
        && request.resource.data.height >= 20
        && request.resource.data.height <= 2000
        && request.resource.data.storagePath is string
        && request.resource.data.storagePath.matches('^design_projects/' + uid + '/' + projectId + '/[A-Za-z0-9_-]{1,80}[.]design[.]json$')
        && request.resource.data.size is int
        && request.resource.data.size > 0
        && request.resource.data.size <= 31457280
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.createdAt is timestamp;
    }
    function validAiDesignGalleryMetadata(uid, designId){
      return request.resource.data.keys().hasOnly([
          'id','title','prompt','presetId','presetName','coverMode','qualityMode',
          'trimWidth','trimHeight','imagePath','backgroundPath','publicPreviewPath',
          'stateJson','createdAt'
        ])
        && request.resource.data.id == designId
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 180
        && request.resource.data.prompt is string
        && request.resource.data.prompt.size() <= 5000
        && request.resource.data.presetId is string
        && request.resource.data.presetId.size() <= 80
        && request.resource.data.presetName is string
        && request.resource.data.presetName.size() <= 120
        && request.resource.data.coverMode in ['front','back','frontBack','spread']
        && request.resource.data.qualityMode in ['standard','high']
        && request.resource.data.trimWidth is number
        && request.resource.data.trimWidth >= 50
        && request.resource.data.trimWidth <= 1000
        && request.resource.data.trimHeight is number
        && request.resource.data.trimHeight >= 50
        && request.resource.data.trimHeight <= 1000
        && request.resource.data.imagePath is string
        && request.resource.data.imagePath.matches('^ai_design_gallery/' + uid + '/' + designId + '/preview[.]jpg$')
        && (!request.resource.data.keys().hasAny(['backgroundPath'])
          || (request.resource.data.backgroundPath is string
            && request.resource.data.backgroundPath.matches('^ai_design_gallery/' + uid + '/' + designId + '/background[.]jpg$')))
        && (!request.resource.data.keys().hasAny(['publicPreviewPath'])
          || (request.resource.data.publicPreviewPath is string
            && request.resource.data.publicPreviewPath.matches('^ai_design_public_gallery/' + uid + '/' + designId + '/preview[.]jpg$')))
        && (!request.resource.data.keys().hasAny(['stateJson'])
          || (request.resource.data.stateJson is string && request.resource.data.stateJson.size() <= 500000))
        && request.resource.data.createdAt is timestamp;
    }

    function validPublicAiDesignGalleryMetadata(designId){
      return request.resource.data.keys().hasOnly([
          'id','ownerUid','prompt','presetId','presetName','coverMode','qualityMode',
          'trimWidth','trimHeight','imagePath','visualMode','colorIntensity',
          'designMood','primaryColor','textColor','promptLanguage','createdAt'
        ])
        && request.resource.data.id == designId
        && request.resource.data.ownerUid is string
        && request.resource.data.ownerUid.size() > 0
        && request.resource.data.ownerUid.size() <= 128
        && request.resource.data.prompt is string
        && request.resource.data.prompt.size() <= 5000
        && request.resource.data.presetId is string
        && request.resource.data.presetId.size() <= 80
        && request.resource.data.presetName is string
        && request.resource.data.presetName.size() <= 120
        && request.resource.data.coverMode in ['front','back','frontBack','spread']
        && request.resource.data.qualityMode in ['standard','high']
        && request.resource.data.trimWidth is number
        && request.resource.data.trimWidth >= 50
        && request.resource.data.trimWidth <= 1000
        && request.resource.data.trimHeight is number
        && request.resource.data.trimHeight >= 50
        && request.resource.data.trimHeight <= 1000
        && request.resource.data.imagePath is string
        && request.resource.data.imagePath.matches('^ai_design_public_gallery/' + request.resource.data.ownerUid + '/' + designId + '/preview[.]jpg$')
        && request.resource.data.visualMode is string
        && request.resource.data.visualMode.size() <= 40
        && request.resource.data.colorIntensity is string
        && request.resource.data.colorIntensity.size() <= 40
        && request.resource.data.designMood is string
        && request.resource.data.designMood.size() <= 40
        && request.resource.data.primaryColor is string
        && request.resource.data.primaryColor.matches('^#[0-9a-fA-F]{6}$')
        && request.resource.data.textColor is string
        && request.resource.data.textColor.matches('^#[0-9a-fA-F]{6}$')
        && request.resource.data.promptLanguage in ['ko','en']
        && request.resource.data.createdAt is timestamp;
    }

    function validPdfSessionMetadata(){
      return request.resource.data.keys().hasOnly(['name','sessionId','storagePaths','fileCount','pageCount','totalBytes','state','createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.sessionId is string
        && request.resource.data.sessionId.matches('^[A-Za-z0-9_-]{8,40}$')
        && request.resource.data.storagePaths is list
        && request.resource.data.fileCount is int
        && request.resource.data.fileCount > 0
        && request.resource.data.fileCount <= 50
        && request.resource.data.storagePaths.size() == request.resource.data.fileCount
        && request.resource.data.pageCount is int
        && request.resource.data.pageCount > 0
        && request.resource.data.pageCount <= 5000
        && request.resource.data.totalBytes is int
        && request.resource.data.totalBytes > 0
        && request.resource.data.totalBytes <= 314572800
        && request.resource.data.state is string
        && request.resource.data.state.size() > 0
        && request.resource.data.state.size() <= 900000
        && request.resource.data.createdAt is timestamp;
    }

    match /settings/admin {
      allow read: if isAdmin();
      allow create: if false;
      allow update, delete: if isAdmin();
    }

    match /settings/programs { allow read: if signedIn(); allow write: if isAdmin(); }
    match /settings/config { allow read, write: if isAdmin(); }
    match /settings/business {
      allow read: if isAdmin() || !resource.data.keys().hasAny(['stampData']);
      allow write: if isAdmin() && !request.resource.data.keys().hasAny(['stampData']);
    }
    match /settings/business_private {
      allow read: if isAdmin();
      allow write: if isAdmin() && validBusinessPrivate();
    }
    match /settings/public_program_catalog { allow read: if true; allow write: if isAdmin(); }
    match /settings/professional_program_suite { allow read: if true; allow write: if isAdmin(); }

    match /user_permissions/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
        && request.auth.token.keys().hasAll(['email'])
        && request.resource.data.keys().hasOnly(['uid','email','displayName','status','createdAt'])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email.lower()
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 100
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is timestamp;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /users/{uid}/design_projects/{projectId} {
      allow read: if isOwner(uid) && approved(uid);
      allow create: if isOwner(uid) && approved(uid) && validDesignProjectMetadata(uid, projectId);
      allow update: if isOwner(uid)
        && approved(uid)
        && validDesignProjectMetadata(uid, projectId)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isOwner(uid);
    }

    // Legacy administrator-provided cover/service image records are retired.
    // Members cannot read them and the web app cannot create or modify them.
    // Administrators retain read/delete access only so old records can be cleaned up safely.
    match /cover_templates/{templateId} {
      allow read, delete: if isAdmin();
      allow create, update: if false;
    }

    match /ai_design_public_gallery/{designId} {
      allow read: if signedIn() && approved(request.auth.uid);
      allow create: if signedIn()
        && approved(request.auth.uid)
        && request.resource.data.ownerUid == request.auth.uid
        && validPublicAiDesignGalleryMetadata(designId);
      allow update: if false;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /users/{uid}/ai_design_gallery/{designId} {
      allow read: if isOwner(uid) && approved(uid);
      allow create: if isOwner(uid) && approved(uid) && validAiDesignGalleryMetadata(uid, designId);
      allow update: if false;
      allow delete: if isOwner(uid);
    }

    match /users/{uid}/pdf_sessions/{docId} {
      allow read: if isOwner(uid) && approved(uid);
      allow create: if isOwner(uid) && approved(uid) && validPdfSessionMetadata();
      allow update: if false;
      allow delete: if isOwner(uid);
    }

    match /users/{uid}/pdf_advanced_sessions/{docId} {
      allow read: if isOwner(uid) && approved(uid);
      allow create: if isOwner(uid) && approved(uid) && validPdfSessionMetadata();
      allow update: if false;
      allow delete: if isOwner(uid);
    }

    match /users/{uid}/pdf_smart_layout_sessions/{docId} {
      allow read: if isOwner(uid) && approved(uid);
      allow create: if isOwner(uid) && approved(uid) && validPdfSessionMetadata();
      allow update: if false;
      allow delete: if isOwner(uid);
    }

    match /users/{uid}/print_checker_sessions/{docId} {
      allow read: if isOwner(uid) && approved(uid);
      allow create: if isOwner(uid) && approved(uid) && validPdfSessionMetadata();
      allow update: if false;
      allow delete: if isOwner(uid);
    }

    match /{document=**} { allow read, write: if false; }
  }
}

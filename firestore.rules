rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function hasAdminClaim() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function adminEmails() {
      return get(/databases/$(database)/documents/settings/admin).data.emails;
    }

    function isAdmin() {
      return hasAdminClaim()
        || (
          isSignedIn()
          && exists(/databases/$(database)/documents/settings/admin)
          && request.auth.token.email != null
          && adminEmails().hasAny([request.auth.token.email, request.auth.token.email.lower()])
        );
    }

    // Administrator addresses are managed through the trusted Cloud Function.
    // Client-side reads and writes are intentionally blocked to avoid leaking
    // administrator email addresses or allowing first-user bootstrap takeover.
    match /settings/admin {
      allow read, write: if false;
    }

    // Signed-in users may read public/private program flags for the UI.
    // Changes are made through /api/admin/programs with server-side admin checks.
    match /settings/programs {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /settings/config {
      allow read, write: if isAdmin();
    }

    match /settings/business {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /user_permissions/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());

      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.auth.token.email != null
        && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'programs', 'createdAt'])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.programs is map
        && request.resource.data.programs.keys().hasOnly(['pdf-editor', 'preflight', 'perfect-binding-cover'])
        && (!('pdf-editor' in request.resource.data.programs) || request.resource.data.programs['pdf-editor'] == false)
        && (!('preflight' in request.resource.data.programs) || request.resource.data.programs['preflight'] == false)
        && (!('perfect-binding-cover' in request.resource.data.programs) || request.resource.data.programs['perfect-binding-cover'] == false);

      // Users may only add missing known program keys with a false value.
      // Administrators manage approvals through trusted server-side tooling.
      allow update: if isAdmin()
        || (
          isSignedIn()
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['programs'])
          && request.resource.data.programs.diff(resource.data.programs).addedKeys().size() > 0
          && request.resource.data.programs.diff(resource.data.programs).changedKeys().size() == 0
          && request.resource.data.programs.diff(resource.data.programs).removedKeys().size() == 0
          && request.resource.data.programs.diff(resource.data.programs).addedKeys()
               .hasOnly(['pdf-editor', 'preflight', 'perfect-binding-cover'])
          && (!('pdf-editor' in request.resource.data.programs.diff(resource.data.programs).addedKeys())
               || request.resource.data.programs['pdf-editor'] == false)
          && (!('preflight' in request.resource.data.programs.diff(resource.data.programs).addedKeys())
               || request.resource.data.programs['preflight'] == false)
          && (!('perfect-binding-cover' in request.resource.data.programs.diff(resource.data.programs).addedKeys())
               || request.resource.data.programs['perfect-binding-cover'] == false)
        );

      allow delete: if isAdmin();
    }

    match /users/{uid}/pdf_history/{docId} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }
    match /users/{uid}/pdf_sessions/{docId} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

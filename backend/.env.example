GOOGLE_APPLICATION_CREDENTIALS=/app/firebase-service-account.json
FIREBASE_STORAGE_BUCKET=program-tool.firebasestorage.app
ALLOWED_ORIGINS=https://program-tool.web.app,http://localhost:5173
OPENAI_API_KEY=
OPENAI_AI_DESIGN_MODEL=gpt-5.6-sol
# Official current GPT Image model used for cover background generation.
OPENAI_AI_IMAGE_MODEL=gpt-image-2
# low / medium / high / auto are supported by GPT Image 2.
OPENAI_AI_IMAGE_QUALITY=high

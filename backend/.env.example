GOOGLE_APPLICATION_CREDENTIALS=/app/firebase-service-account.json
FIREBASE_STORAGE_BUCKET=program-tool.firebasestorage.app
ALLOWED_ORIGINS=https://program-tool.web.app,http://localhost:5173
OPENAI_API_KEY=
# Admin dashboard exact billing data uses OpenAI organization Admin APIs.
# Keep this server-only. A normal project API key cannot read /organization/costs.
OPENAI_ADMIN_KEY=
# Strongly recommended: scope exact costs/usage to the Program Studio OpenAI project.
# If omitted, the admin dashboard clearly labels the amount as organization-wide.
OPENAI_PROJECT_ID=
OPENAI_ADMIN_USAGE_TIMEOUT_SECONDS=20
OPENAI_AI_DESIGN_MODEL=gpt-5.6-sol
# Official current GPT Image model used for cover background generation.
OPENAI_AI_IMAGE_MODEL=gpt-image-2
# low / medium / high / auto are supported by GPT Image 2.
OPENAI_AI_IMAGE_QUALITY=high
# GPT Image can take up to about two minutes for complex requests. Allowed: 60-300 seconds.
OPENAI_AI_IMAGE_TIMEOUT_SECONDS=180

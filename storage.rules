rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isPdfUpload() {
      return request.resource != null
        && request.resource.size <= 100 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
    }

    match /pdf_history/{userId}/{allPaths=**} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && isPdfUpload();
    }
    match /pdf_temp/{userId}/{allPaths=**} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && isPdfUpload();
    }
    match /preflight_temp/{userId}/{allPaths=**} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && isPdfUpload();
    }
    match /pdf_sessions/{userId}/{allPaths=**} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && isPdfUpload();
    }
  }
}

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isOwner(userId) { return signedIn() && request.auth.uid == userId; }
    function hasAdminClaim() {
      return signedIn() && request.auth.token.admin == true;
    }
    function legacyAdmin() {
      return signedIn()
        && request.auth.token.email != null
        && firestore.exists(/databases/(default)/documents/settings/admin)
        && firestore.get(/databases/(default)/documents/settings/admin).data.emails.hasAny([
          request.auth.token.email,
          request.auth.token.email.lower()
        ]);
    }
    function isAdmin() { return hasAdminClaim() || legacyAdmin(); }
    function isApproved() {
      return isAdmin()
        || (
          signedIn()
          && firestore.exists(/databases/(default)/documents/user_permissions/$(request.auth.uid))
          && firestore.get(/databases/(default)/documents/user_permissions/$(request.auth.uid)).data.status == 'approved'
        );
    }
    function canUseProgram(programId) {
      return isApproved();
    }
    function validPdfUpload(maxBytes) {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= maxBytes
        && request.resource.contentType == 'application/pdf';
    }
    function validStagePath(sessionId, fileName) {
      return sessionId.matches('^[A-Za-z0-9_-]{8,40}$')
        && fileName.matches('^[A-Za-z0-9_.-]{1,100}[.]pdf$');
    }
    function validSessionUpload(userId, sessionId, fileName) {
      return validPdfUpload(209715200)
        && sessionId.matches('^[A-Za-z0-9_-]{8,40}$')
        && fileName.matches('^src_[0-9]{1,2}[.]pdf$')
        && request.resource.metadata != null
        && request.resource.metadata.ownerUid == userId
        && request.resource.metadata.purpose == 'pdf-session-source'
        && request.resource.metadata.sessionId == sessionId;
    }
    function isDesignProjectUpload(userId, projectId, fileName) {
      return isOwner(userId)
        && isApproved()
        && projectId.matches('^[A-Za-z0-9_-]{1,80}$')
        && fileName.matches('^[A-Za-z0-9_-]{1,80}[.]design[.]json$')
        && request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 31457280
        && request.resource.contentType == 'application/json'
        && request.resource.metadata != null
        && request.resource.metadata.ownerUid == userId
        && request.resource.metadata.format == 'program-studio-design-project';
    }

    // Short-lived staging. The backend accepts at most 200 MiB per file and
    // 300 MiB per PDF job, so Storage must never accept a larger single object.
    // Updates are denied to avoid accidental duplicate transfer/overwrite cost.
    match /pdf_temp/{userId}/{sessionId}/{fileName} {
      allow read: if isOwner(userId) && canUseProgram('pdf-editor');
      allow delete: if isOwner(userId);
      allow create: if isOwner(userId)
        && canUseProgram('pdf-editor')
        && validStagePath(sessionId, fileName)
        && validPdfUpload(209715200);
      allow update: if false;
    }
    match /preflight_temp/{userId}/{sessionId}/{fileName} {
      allow read: if isOwner(userId) && canUseProgram('preflight');
      allow delete: if isOwner(userId);
      allow create: if isOwner(userId)
        && canUseProgram('preflight')
        && validStagePath(sessionId, fileName)
        && validPdfUpload(209715200);
      allow update: if false;
    }

    // Saved editor sessions are persistent user data. New/updated source files
    // are limited to the same 200 MiB per-file ceiling and must carry ownership
    // metadata. Existing legacy objects remain readable/deletable by their owner.
    match /pdf_sessions/{userId}/{sessionId}/{fileName} {
      allow read, delete: if isOwner(userId) && canUseProgram('pdf-editor');
      allow create, update: if isOwner(userId)
        && canUseProgram('pdf-editor')
        && validSessionUpload(userId, sessionId, fileName);
    }
    match /pdf_results/{userId}/{resultId}/{fileName} {
      // Generated results are uploaded only by the server. The owner may remove
      // their own temporary result immediately after download to avoid storage cost.
      allow read: if isOwner(userId)
        && (canUseProgram('pdf-editor') || canUseProgram('preflight'));
      allow delete: if isOwner(userId);
      allow create, update: if false;
    }

    match /design_projects/{userId}/{projectId}/{fileName} {
      allow read: if isOwner(userId) && isApproved();
      allow delete: if isOwner(userId);
      // Revisions are immutable: a save writes a new revision and then removes
      // the previous one after Firestore metadata commits successfully.
      allow create: if isDesignProjectUpload(userId, projectId, fileName);
      allow update: if false;
    }

    // Legacy administrator-provided cover/service images are retired.
    // New or replacement files cannot be uploaded by the web app. Administrators
    // retain read/delete access only so existing objects can be removed safely.
    match /cover_templates/{templateId}/{fileName} {
      allow read, delete: if isAdmin();
      allow create, update: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isOwner(userId) { return signedIn() && request.auth.uid == userId; }
    function hasAdminClaim() {
      return signedIn()
        && request.auth.token.keys().hasAll(['admin'])
        && request.auth.token.admin == true;
    }
    function legacyAdmin() {
      return signedIn()
        && request.auth.token.keys().hasAll(['email'])
        && request.auth.token.email != null
        && firestore.get(/databases/(default)/documents/settings/admin).data.emails.hasAny([
          request.auth.token.email,
          request.auth.token.email.lower()
        ]);
    }
    function isAdmin() { return hasAdminClaim() || legacyAdmin(); }
    function permissionData() {
      return firestore.get(/databases/(default)/documents/user_permissions/$(request.auth.uid)).data;
    }
    function isApproved() {
      return isAdmin()
        || (
          signedIn()
          && permissionData().status == 'approved'
        );
    }
    function canUseProgram(programId) {
      let data = permissionData();
      return isAdmin()
        || (
          signedIn()
          && data.status == 'approved'
          && (
            !data.keys().hasAny(['programsAll'])
            || data.programsAll == true
            || (
              data.programs is map
              && data.programs.keys().hasAny([programId])
              && data.programs[programId] == true
            )
          )
        );
    }
    function canUseAnyPdfSessionProgram() {
      return canUseProgram('pdf-editor')
        || canUseProgram('pdf-editor-advanced')
        || canUseProgram('smart-print-layout');
    }
    function validPdfUpload(maxBytes) {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= maxBytes
        && request.resource.contentType == 'application/pdf';
    }
    function validStagePath(sessionId, fileName) {
      return sessionId.matches('^[A-Za-z0-9_-]{8,40}$')
        && fileName.matches('^[A-Za-z0-9_.-]{1,100}[.][Pp][Dd][Ff]$');
    }
    function validSessionUpload(userId, sessionId, fileName) {
      return validPdfUpload(209715200)
        && sessionId.matches('^[A-Za-z0-9_-]{8,40}$')
        && fileName.matches('^src_[0-9]{1,2}[.]pdf$')
        && request.resource.metadata != null
        && request.resource.metadata.keys().hasAll(['ownerUid', 'purpose', 'sessionId'])
        && request.resource.metadata.ownerUid == userId
        && request.resource.metadata.purpose == 'pdf-session-source'
        && request.resource.metadata.sessionId == sessionId;
    }
    function isDesignProjectUpload(userId, projectId, fileName) {
      return isOwner(userId)
        && isApproved()
        && projectId.matches('^[A-Za-z0-9_-]{1,80}$')
        && fileName.matches('^[A-Za-z0-9_-]{1,80}[.]design[.]json$')
        && request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 31457280
        && request.resource.contentType == 'application/json'
        && request.resource.metadata != null
        && request.resource.metadata.keys().hasAll(['ownerUid', 'format'])
        && request.resource.metadata.ownerUid == userId
        && request.resource.metadata.format == 'program-studio-design-project';
    }

    // Short-lived staging remains owner-scoped. The backend validates the exact
    // approved program before processing the staged object, so no extra Firestore
    // read is spent on every chunk/upload operation here.
    match /pdf_temp/{userId}/{sessionId}/{fileName} {
      allow read: if isOwner(userId);
      allow delete: if isOwner(userId);
      allow create: if resource == null
        && isOwner(userId)
        && validStagePath(sessionId, fileName)
        && validPdfUpload(209715200);
      allow update: if false;
    }
    match /preflight_temp/{userId}/{sessionId}/{fileName} {
      allow read: if isOwner(userId);
      allow delete: if isOwner(userId);
      allow create: if resource == null
        && isOwner(userId)
        && validStagePath(sessionId, fileName)
        && validPdfUpload(209715200);
      allow update: if false;
    }

    // All three PDF editors share the persistent source prefix. Exact API access
    // is checked server-side; Storage only needs one of the PDF-session programs.
    match /pdf_sessions/{userId}/{sessionId}/{fileName} {
      allow read, delete: if isOwner(userId) && canUseAnyPdfSessionProgram();
      allow create: if resource == null
        && isOwner(userId)
        && canUseAnyPdfSessionProgram()
        && validSessionUpload(userId, sessionId, fileName);
      allow update: if false;
    }
    match /pdf_results/{userId}/{resultId}/{fileName} {
      allow read: if isOwner(userId);
      allow delete: if isOwner(userId);
      allow create, update: if false;
    }

    match /design_projects/{userId}/{projectId}/{fileName} {
      allow read: if isOwner(userId) && isApproved();
      allow delete: if isOwner(userId);
      allow create: if resource == null
        && isDesignProjectUpload(userId, projectId, fileName);
      allow update: if false;
    }

    match /cover_templates/{templateId}/{fileName} {
      allow read, delete: if isAdmin();
      allow create, update: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isOwner(userId) { return signedIn() && request.auth.uid == userId; }
    function isAdmin() {
      return signedIn()
        && request.auth.token.email != null
        && firestore.exists(/databases/(default)/documents/settings/admin)
        && firestore.get(/databases/(default)/documents/settings/admin).data.emails.hasAny([
          request.auth.token.email,
          request.auth.token.email.lower()
        ]);
    }
    function isApproved() {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/user_permissions/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/user_permissions/$(request.auth.uid)).data.status == 'approved';
    }
    function isPublicCoverTemplate(templateId) {
      return firestore.exists(/databases/(default)/documents/cover_templates/$(templateId))
        && firestore.get(/databases/(default)/documents/cover_templates/$(templateId)).data.isPublic == true;
    }
    function isPdfUpload() {
      return request.resource != null
        && request.resource.size <= 209715200
        && request.resource.contentType == 'application/pdf';
    }
    function isCoverImage() {
      return request.resource != null
        && request.resource.size <= 15728640
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    match /pdf_history/{userId}/{allPaths=**} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && isPdfUpload();
    }
    match /pdf_temp/{userId}/{allPaths=**} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && isPdfUpload();
    }
    match /preflight_temp/{userId}/{allPaths=**} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && isPdfUpload();
    }
    match /pdf_sessions/{userId}/{allPaths=**} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && isPdfUpload();
    }
    match /cover_templates/{templateId}/{fileName} {
      allow read: if isAdmin() || (isApproved() && isPublicCoverTemplate(templateId));
      allow create, update: if isAdmin() && isCoverImage();
      allow delete: if isAdmin();
    }
  }
}

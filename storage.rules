rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isOwner(userId) { return signedIn() && request.auth.uid == userId; }
    function hasAdminClaim() {
      return signedIn() && request.auth.token.admin == true;
    }
    function legacyAdmin() {
      return signedIn()
        && request.auth.token.email != null
        && firestore.exists(/databases/(default)/documents/settings/admin)
        && firestore.get(/databases/(default)/documents/settings/admin).data.emails.hasAny([
          request.auth.token.email,
          request.auth.token.email.lower()
        ]);
    }
    function isAdmin() { return hasAdminClaim() || legacyAdmin(); }
    function isApproved() {
      return isAdmin()
        || (
          signedIn()
          && firestore.exists(/databases/(default)/documents/user_permissions/$(request.auth.uid))
          && firestore.get(/databases/(default)/documents/user_permissions/$(request.auth.uid)).data.status == 'approved'
        );
    }
    function isPublicProgram(programId) {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/settings/programs)
        && firestore.get(/databases/(default)/documents/settings/programs).data.public is map
        && firestore.get(/databases/(default)/documents/settings/programs).data.public[programId] == true;
    }
    function canUseProgram(programId) {
      return isApproved() || isPublicProgram(programId);
    }
    function isPdfUpload() {
      return request.resource != null
        && request.resource.size <= 524288000
        && request.resource.contentType == 'application/pdf';
    }
    function isDesignProjectUpload(userId, projectId, fileName) {
      return isOwner(userId)
        && projectId.matches('^[A-Za-z0-9_-]{1,80}$')
        && fileName.matches('^[A-Za-z0-9_-]{1,80}[.]design[.]json$')
        && request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 31457280
        && request.resource.contentType == 'application/json'
        && request.resource.metadata.ownerUid == userId
        && request.resource.metadata.format == 'program-studio-design-project';
    }

    // Ephemeral staging for server-authorized PDF work.
    // The browser must be able to stage its own PDF before the backend request can
    // perform the authoritative program-access check. Requiring canUseProgram()
    // here duplicated that check against a separate Firestore lookup and could
    // reject a valid signed-in user before the API was ever called.
    // Files remain isolated by UID, limited to PDF/500MB, and are covered by the
    // one-day Storage lifecycle cleanup.
    match /pdf_temp/{userId}/{sessionId}/{fileName} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && isPdfUpload();
    }
    match /preflight_temp/{userId}/{sessionId}/{fileName} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && isPdfUpload();
    }

    // Saved editor sessions are persistent user data, so keep the program-access
    // policy here rather than treating them like short-lived staging objects.
    match /pdf_sessions/{userId}/{sessionId}/{fileName} {
      allow read, delete: if isOwner(userId) && canUseProgram('pdf-editor');
      allow create, update: if isOwner(userId) && canUseProgram('pdf-editor') && isPdfUpload();
    }
    match /pdf_results/{userId}/{resultId}/{fileName} {
      // Generated results are uploaded only by the server. The owner may remove
      // their own temporary result immediately after download to avoid storage cost.
      allow read: if isOwner(userId)
        && (canUseProgram('pdf-editor') || canUseProgram('preflight'));
      allow delete: if isOwner(userId);
      allow create, update: if false;
    }

    match /design_projects/{userId}/{projectId}/{fileName} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isDesignProjectUpload(userId, projectId, fileName);
    }

    // Legacy administrator-provided cover/service images are retired.
    // New or replacement files cannot be uploaded by the web app. Administrators
    // retain read/delete access only so existing objects can be removed safely.
    match /cover_templates/{templateId}/{fileName} {
      allow read, delete: if isAdmin();
      allow create, update: if false;
    }
  }
}

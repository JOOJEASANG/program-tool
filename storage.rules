rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isOwner(userId) { return signedIn() && request.auth.uid == userId; }
    function hasAdminClaim() {
      return signedIn()
        && request.auth.token.keys().hasAll(['admin'])
        && request.auth.token.admin == true;
    }
    function legacyAdmin() {
      return signedIn()
        && request.auth.token.keys().hasAll(['email'])
        && request.auth.token.email != null
        && firestore.get(/databases/(default)/documents/settings/admin).data.emails.hasAny([
          request.auth.token.email,
          request.auth.token.email.lower()
        ]);
    }
    function isAdmin() { return hasAdminClaim() || legacyAdmin(); }
    function isApproved() {
      return isAdmin()
        || (
          signedIn()
          && firestore.get(/databases/(default)/documents/user_permissions/$(request.auth.uid)).data.status == 'approved'
        );
    }
    function canUseProgram(programId) {
      return programId == 'pdf-editor' && isApproved();
    }
    function validPdfUpload(maxBytes) {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= maxBytes
        && request.resource.contentType == 'application/pdf';
    }
    function validStagePath(sessionId, fileName) {
      return sessionId.matches('^[A-Za-z0-9_-]{8,40}$')
        && fileName.matches('^[A-Za-z0-9_.-]{1,100}[.][Pp][Dd][Ff]$');
    }
    function validSessionUpload(userId, sessionId, fileName) {
      return validPdfUpload(209715200)
        && sessionId.matches('^[A-Za-z0-9_-]{8,40}$')
        && fileName.matches('^src_[0-9]{1,2}[.]pdf$')
        && request.resource.metadata != null
        && request.resource.metadata.keys().hasAll(['ownerUid', 'purpose', 'sessionId'])
        && request.resource.metadata.ownerUid == userId
        && request.resource.metadata.purpose == 'pdf-session-source'
        && request.resource.metadata.sessionId == sessionId;
    }
    function isDesignProjectUpload(userId, projectId, fileName) {
      return isOwner(userId)
        && isApproved()
        && projectId.matches('^[A-Za-z0-9_-]{1,80}$')
        && fileName.matches('^[A-Za-z0-9_-]{1,80}[.]design[.]json$')
        && request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 31457280
        && request.resource.contentType == 'application/json'
        && request.resource.metadata != null
        && request.resource.metadata.keys().hasAll(['ownerUid', 'format'])
        && request.resource.metadata.ownerUid == userId
        && request.resource.metadata.format == 'program-studio-design-project';
    }

    match /pdf_temp/{userId}/{sessionId}/{fileName} {
      allow read: if isOwner(userId) && isApproved();
      allow delete: if isOwner(userId) && isApproved();
      allow create: if resource == null
        && isOwner(userId)
        && isApproved()
        && validStagePath(sessionId, fileName)
        && validPdfUpload(524288000);
      allow update: if false;
    }
    match /preflight_temp/{userId}/{sessionId}/{fileName} {
      allow read: if isOwner(userId) && isApproved();
      allow delete: if isOwner(userId) && isApproved();
      allow create: if resource == null
        && isOwner(userId)
        && isApproved()
        && validStagePath(sessionId, fileName)
        && validPdfUpload(524288000);
      allow update: if false;
    }

    match /pdf_sessions/{userId}/{sessionId}/{fileName} {
      allow read, delete: if isOwner(userId) && canUseProgram('pdf-editor');
      allow create: if resource == null
        && isOwner(userId)
        && canUseProgram('pdf-editor')
        && validSessionUpload(userId, sessionId, fileName);
      allow update: if false;
    }
    match /pdf_results/{userId}/{resultId}/{fileName} {
      // Reading a generated result is still part of program use, so approval is
      // required. Owners may delete old results even after access is suspended.
      allow read: if isOwner(userId) && isApproved();
      allow delete: if isOwner(userId);
      allow create, update: if false;
    }

    match /design_projects/{userId}/{projectId}/{fileName} {
      allow read: if isOwner(userId) && isApproved();
      allow delete: if isOwner(userId);
      allow create: if resource == null
        && isDesignProjectUpload(userId, projectId, fileName);
      allow update: if false;
    }

    match /cover_templates/{templateId}/{fileName} {
      allow read, delete: if isAdmin();
      allow create, update: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}